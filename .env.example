# Copy these into Replit → Tools → Secrets (never commit real values).

# Required
ADMIN_PASSWORD=pick-a-long-passphrase        # unlocks /admin (the hunt desk)
DATABASE_URL=                                # auto-set when you add Replit's PostgreSQL database

# Stripe Payment Links — one per tier (Stripe → Payment Links → New)
# Set each link's "After payment" redirect to: https://insearchof.shop/paid
STRIPE_LINK_7=https://buy.stripe.com/...
STRIPE_LINK_30=https://buy.stripe.com/...
STRIPE_LINK_60=https://buy.stripe.com/...
# Optional but recommended: auto-marks hunts paid. Stripe → Developers → Webhooks →
# endpoint https://insearchof.shop/api/stripe/webhook, event checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# Nice to have
BASE_URL=https://insearchof.shop             # used in WhatsApp drafts + share links
CONTACT_WHATSAPP=+14155550134                # your WhatsApp Business number (footer link)
CONTACT_EMAIL=hello@insearchof.shop
INSTAGRAM_HANDLE=insearchof.shop
TIKTOK_HANDLE=insearchof
CRAIGSLIST_REGION=sfbay                      # subdomain for Craigslist sweep links
SESSION_SECRET=                              # optional; defaults to a hash of ADMIN_PASSWORD
